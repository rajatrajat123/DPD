# ==============================================================================
# Aura LGBTQ+ Dating Platform — Environment Configuration Example
# Copy to .env for local development. Never commit real secrets to git.
# ==============================================================================

# --- Application Identity & Runtime ---
APP_ENV=development
SERVICE_NAME=aura-api
APP_VERSION=0.1.0-phase01

# --- HTTP Server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL 16 + PostGIS 3.4 ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password
POSTGRES_DB=aura_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://aura:aura_dev_password@localhost:5432/aura_dev?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=10m
DB_CONNECT_TIMEOUT=5s

# --- Redis 7.4 ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20

# --- Security & Cryptography ---
# Minimum 32 bytes required in staging/production
JWT_SIGNING_SECRET=dev-only-jwt-signing-secret-must-be-at-least-32-bytes-long
AURA_SESSION_HMAC_SECRET=dev-only-aura-session-hmac-secret-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js Public Website (web/) ---
NEXT_PUBLIC_SITE_URL=https://auradating.com

# --- Mobile App Store Identifiers ---
# Explicit configuration for in-app purchase verification and store subscription cancellation.
# Must match native apps/mobile/app.json (ios.bundleIdentifier & android.package).
APPLE_BUNDLE_ID=com.aura.dating
GOOGLE_PLAY_PACKAGE_NAME=com.aura.dating

