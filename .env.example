# ==============================================================================
# Aura LGBTQ+ Dating Platform — Environment Configuration Example
# Copy to .env for local development. Never commit real secrets to git.
# ==============================================================================

# --- Application Identity & Runtime ---
APP_ENV=development
SERVICE_NAME=aura-api
APP_VERSION=0.1.0-phase01

# --- HTTP Server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL 16 + PostGIS 3.4 ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password
POSTGRES_DB=aura_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://aura:aura_dev_password@localhost:5432/aura_dev?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=10m
DB_CONNECT_TIMEOUT=5s

# --- Redis 7.4 ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20

# --- Security & Cryptography ---
# Minimum 32 bytes required in staging/production.
# The Next.js website (web/) verifies the same HS256 access tokens, so it must be
# given the identical secret through JWT_SIGNING_SECRET (or AURA_SESSION_HMAC_SECRET).
# There is no hardcoded fallback: without a secret the website treats every request
# as unauthenticated and private routes redirect to /auth/login.
JWT_SIGNING_SECRET=dev-only-jwt-signing-secret-must-be-at-least-32-bytes-long
AURA_SESSION_HMAC_SECRET=dev-only-aura-session-hmac-secret-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js Public Website (web/) ---
NEXT_PUBLIC_SITE_URL=https://auradating.com
# Backend origin used by the website BFF (login/register/session/proxy).
# Production builds fail closed with HTTP 503 if this is not configured:
# they never fall back to a localhost/LAN API address.
AURA_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# --- Google Sign-In (OpenID Connect) ---
# The backend is the only component that decides whether a Google identity is
# genuine. It validates the ID token signature, issuer, audience and expiry using
# google.golang.org/api/idtoken, so every OAuth client ID that can obtain a token
# must be listed here. Wildcards are rejected in staging/production and the
# backend fails closed (HTTP 503) when no audience is configured.
#
# Expected values (comma separated):
#   - Android OAuth client ID  (must match android.package / SHA-1 signing fingerprint)
#   - iOS OAuth client ID      (must match ios.bundleIdentifier)
#   - Web OAuth client ID      (server/"web" client ID given to the native SDK)
GOOGLE_OAUTH_AUDIENCES=
GOOGLE_OAUTH_CLIENT_ID=

# --- Mobile App Google Sign-In (apps/mobile) ---
# Expo inlines EXPO_PUBLIC_* values at build time. The native Google Sign-In
# module (see apps/mobile/src/components/GoogleSignInButton.tsx) reports
# "not configured" instead of inventing a local identity when the client ID its
# platform needs is missing.
# See Google Cloud console -> APIs & Services -> Credentials.
#
# WEB: required. The native SDK only returns an ID token when configured with the
# Web ("server") client ID, so an Android build does not work without it. It is
# also used on iOS when no iOS client ID is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ANDROID: not passed to the SDK. Google matches Android clients through the
# package name (com.aura.dating) plus the signing SHA-1 registered in the console.
# Keep it here as the reference value for that registration and for the backend's
# GOOGLE_OAUTH_AUDIENCES.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# IOS: passed to the SDK on iOS. An iOS build additionally needs the module's
# config plugin in apps/mobile/app.json with
# "iosUrlScheme": "com.googleusercontent.apps.<ios-client-id-without-suffix>".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Mobile App Runtime (apps/mobile) ---
# Required for production builds: production refuses to fall back to a developer
# LAN IP and refuses plaintext HTTP. Use the public HTTPS API origin.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=

# --- Mobile App Store Identifiers ---
# Explicit configuration for in-app purchase verification and store subscription cancellation.
# Must match native apps/mobile/app.json (ios.bundleIdentifier & android.package).
APPLE_BUNDLE_ID=com.aura.dating
GOOGLE_PLAY_PACKAGE_NAME=com.aura.dating

# --- Apple App Store Server API (In-App Purchases) ---
# Credentials from App Store Connect -> Users and Access -> Integrations -> In-App Purchase.
# The backend validates signed StoreKit 2 transactions and connects to App Store Server API.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# PKCS#8 PEM private key (e.g. SubscriptionKey_XXXXXXXXXX.p8) content or base64
APPLE_PRIVATE_KEY=
# Optional App Store numeric application ID
APPLE_APP_APPLE_ID=
# "production" or "sandbox" (defaults to sandbox if APP_ENV != production)
APPLE_ENVIRONMENT=sandbox
# Legacy shared secret (fallback only)
APPLE_SHARED_SECRET=

# --- Google Play Developer API (In-App Purchases) ---
# Google Cloud Service Account JSON key with Android Publisher permissions.
# Required for server-side verification of Google Play subscriptions and consumables.
GOOGLE_PLAY_CREDENTIALS_JSON=

# --- Transactional Email & Account Recovery (Resend) ---
# Resend API Key from https://resend.com/api-keys
# Required in production/staging; in development/local, omitting this falls back to safe dev logging.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aura <security@aura.dating>
PASSWORD_RESET_URL_BASE=http://192.168.29.15:8080/auth/reset-password
EXPO_GO_URL_BASE=exp://192.168.29.15:8081/--/reset-password

# --- Resend Sender Domain & DNS Configuration ---
# To send production emails from your verified domain (e.g. aura.dating):
# 1. In Resend Dashboard, go to Domains -> "Add Domain" -> enter your domain (e.g., aura.dating).
# 2. Add the DNS records provided by Resend to your domain registrar (e.g. Cloudflare, Route53, Namecheap):
#    - DKIM: TXT or CNAME record (host: resend._domainkey, value provided by Resend).
#    - SPF: TXT record on root domain "@": "v=spf1 include:amazonses.com ~all".
#    - DMARC: TXT record on "_dmarc": "v=DMARC1; p=reject; rua=mailto:dmarc@aura.dating".
#    - Return-Path / MX: MX record for bounce handling (e.g. host: "bounces", value provided by Resend).
# 3. Wait for DNS propagation and click "Verify" in the Resend dashboard.
# 4. Once verified, configure RESEND_API_KEY with your live Resend API key.

# --- Media Storage & Automatic Retention ---
MEDIA_STORAGE_DIR=data/media
MEDIA_RETENTION_INTERVAL=1h
MEDIA_RETENTION_BATCH_SIZE=100



# --- Google AdMob Server-Side Verification (SSV) ---
# Callback endpoint configured in AdMob Console for rewarded ad units:
# AdMob Console -> Apps -> Ad units -> Select Rewarded Unit -> Advanced settings -> Server-side verification:
# Set Callback URL to: https://api.auradating.com/api/v1/ads/admob/ssv
ADMOB_SSV_CALLBACK_URL=https://api.auradating.com/api/v1/ads/admob/ssv
