# ==============================================================================
# Aura Staging Environment Variables Template
# Secrets should be securely injected via AWS Secrets Manager, Vault, or CI/CD secrets.
# Never commit populated staging credentials to version control.
# ==============================================================================

# Application & Runtime
APP_ENV=staging
SERVICE_NAME=aura-api
APP_VERSION=1.0.0-rc1
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_USER=aura_staging_app
POSTGRES_PASSWORD=<SECURE_DATABASE_PASSWORD_FROM_SECRETS_MANAGER>
POSTGRES_DB=aura_staging
DATABASE_URL=postgres://aura_staging_app:<SECURE_DATABASE_PASSWORD_FROM_SECRETS_MANAGER>@staging-postgres.internal:5432/aura_staging?sslmode=verify-full
DB_MAX_CONNS=30
DB_MIN_CONNS=5
DB_CONNECT_TIMEOUT=5s

# Redis 7.4 TLS
REDIS_URL=rediss://default:<SECURE_REDIS_PASSWORD>@staging-redis.internal:6379/0
REDIS_POOL_SIZE=25

# Security Secrets (Must be at least 32 cryptographically random bytes)
JWT_SIGNING_SECRET=<SECURE_64_CHAR_HEX_FROM_SECRETS_MANAGER>
AURA_SESSION_HMAC_SECRET=<SECURE_64_CHAR_HEX_FROM_SECRETS_MANAGER>
CORS_ALLOWED_ORIGINS=https://staging.auradating.com,https://admin.staging.auradating.com

# Billing & Sandbox Adapters
STRIPE_SECRET_KEY=sk_test_<SECURE_STRIPE_TEST_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<SECURE_STRIPE_WEBHOOK_SECRET>
APPLE_SHARED_SECRET=<APPLE_SANDBOX_SHARED_SECRET>
APPLE_BUNDLE_ID=com.aura.dating
GOOGLE_PLAY_CREDENTIALS_JSON=<GOOGLE_PLAY_SERVICE_ACCOUNT_JSON>
GOOGLE_PLAY_PACKAGE_NAME=com.aura.dating

# Media Pipeline & Quarantine S3
MEDIA_STORAGE_DIR=/data/media_quarantine
S3_QUARANTINE_BUCKET=aura-media-quarantine-staging
S3_APPROVED_BUCKET=aura-media-approved-staging
CDN_BASE_URL=https://media.staging.auradating.com

# Web & Staging Domain
NEXT_PUBLIC_SITE_URL=https://staging.auradating.com
NEXT_PUBLIC_API_URL=https://api.staging.auradating.com
